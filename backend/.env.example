# Active Profile (local | prod)
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Security & CORS
SECURITY_API_KEY=dev-secret-api-key-change-in-prod
FRONTEND_ORIGIN=http://localhost:5173,http://localhost:3000

# Cloudinary Integration
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_AUTO_TAGGING_CATEGORIZATION=aws_rek_tagging

# Blockchain Integration (MOCK | HTTP)
BLOCKCHAIN_MODE=MOCK
BLOCKCHAIN_SERVICE_URL=http://localhost:4000
BLOCKCHAIN_CONNECT_TIMEOUT_MS=5000
BLOCKCHAIN_READ_TIMEOUT_STANDARD_MS=10000
BLOCKCHAIN_READ_TIMEOUT_LONG_MS=120000

# Database Configuration (PostgreSQL for prod profile)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mediaprovenance
DB_USERNAME=postgres
DB_PASSWORD=postgres

# File Upload Limits
UPLOAD_MAX_FILE_SIZE=10MB
UPLOAD_MAX_REQUEST_SIZE=12MB
